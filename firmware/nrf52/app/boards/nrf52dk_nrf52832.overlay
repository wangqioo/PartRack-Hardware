/ {
    vbrk_led_data: vbrk_led_data {
        gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
    };

    vbrk_led_power: vbrk_led_power {
        gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
    };

    vbrk_nfc_fd: vbrk_nfc_fd {
        gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
    };

    aliases {
        vbrk-led-data = &vbrk_led_data;
        vbrk-led-power = &vbrk_led_power;
        vbrk-nfc-fd = &vbrk_nfc_fd;
    };
};
